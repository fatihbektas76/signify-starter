# Signify API base URL (production: https://sign.echtly.de)
SIGNIFY_API_URL=https://sign.echtly.de

# API key from Signify dashboard: /developers → API Keys → create (scope: write)
# Format: sk_...
SIGNIFY_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret from Signify dashboard: /developers → Webhooks → create
# Used to verify incoming webhook signatures (HMAC-SHA256)
SIGNIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# For the smoke-test script only: a template ID to instantiate
# (any Regular Template from your team)
SIGNIFY_SMOKE_TEMPLATE_ID=
SIGNIFY_SMOKE_RECIPIENT_EMAIL=you@example.com

# Example server port
PORT=4000
